1. Rotting Oranges (Multi-Source BFS)Problem: Given an $m \times n$ grid where 0 is an empty cell, 1 is a fresh orange, and 2 is a rotten orange, return the minimum number of minutes until no cell has a fresh orange. If this is impossible, return -1.Pythonfrom collections import deque

def orangesRotting(grid: list[list[int]]) -> int:
    rows, cols = len(grid), len(grid[0])
    queue = deque()
    fresh = 0
    
    # Push all initial rotten oranges into BFS queue
    for r in range(rows):
        for c in range(cols):
            if grid[r][c] == 2:
                queue.append((r, c))
            elif grid[r][c] == 1:
                fresh += 1
                
    if fresh == 0:
        return 0
        
    minutes = 0
    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]
    
    # Process grid level by level
    while queue and fresh > 0:
        minutes += 1
        for _ in range(len(queue)):
            r, c = queue.popleft()
            for dr, dc in directions:
                nr, nc = r + dr, c + dc
                if 0 <= nr < rows and 0 <= nc < cols and grid[nr][nc] == 1:
                    grid[nr][nc] = 2
                    fresh -= 1
                    queue.append((nr, nc))
                    
    return minutes if fresh == 0 else -1
2. Course Schedule II (Topological Sort / Kahn's Algorithm)Problem: Given numCourses labeled 0 to n-1 and a list of prerequisites where prerequisites[i] = [a, b] means course b must be taken before a, return the ordering of courses you should take to finish all courses. Return [] if cycle detected.Pythonfrom collections import deque, defaultdict

def findOrder(numCourses: int, prerequisites: list[list[int]]) -> list[int]:
    adj = defaultdict(list)
    in_degree = [0] * numCourses
    
    # Build graph and in-degree array
    for dest, src in prerequisites:
        adj[src].append(dest)
        in_degree[dest] += 1
        
    # Queue nodes with in-degree 0
    queue = deque([i for i in range(numCourses) if in_degree[i] == 0])
    topo_order = []
    
    while queue:
        node = queue.popleft()
        topo_order.append(node)
        
        for neighbor in adj[node]:
            in_degree[neighbor] -= 1
            if in_degree[neighbor] == 0:
                queue.append(neighbor)
                
    return topo_order if len(topo_order) == numCourses else []
3. Number of Islands (Grid Connected Components)Problem: Given an $m \times n$ 2D binary grid representing a map of '1's (land) and '0's (water), return the total number of islands (connected components of 1s horizontally or vertically).Pythondef numIslands(grid: list[list[str]]) -> int:
    if not grid:
        return 0
        
    rows, cols = len(grid), len(grid[0])
    islands = 0
    
    def dfs(r, c):
        if r < 0 or r >= rows or c < 0 or c >= cols or grid[r][c] != '1':
            return
        grid[r][c] = '0'  # Mark visited by sinking the land
        dfs(r + 1, c)
        dfs(r - 1, c)
        dfs(r, c + 1)
        dfs(r, c - 1)
        
    for r in range(rows):
        for c in range(cols):
            if grid[r][c] == '1':
                islands += 1
                dfs(r, c)
                
    return islands
4. Dijkstra's Algorithm (Shortest Path in Weighted Graph)Problem: Given a weighted graph with V vertices and an adjacency list where adj[u] = [(v, w)], return an array of shortest distances from source node src to all other vertices.Pythonimport heapq

def dijkstra(V: int, adj: list[list[tuple[int, int]]], src: int) -> list[int]:
    dist = [float('inf')] * V
    dist[src] = 0
    
    # Min-heap storing tuples: (distance, node)
    pq = [(0, src)]
    
    while pq:
        d, u = heapq.heappop(pq)
        
        if d > dist[u]:
            continue
            
        for v, weight in adj[u]:
            if dist[u] + weight < dist[v]:
                dist[v] = dist[u] + weight
                heapq.heappush(pq, (dist[v], v))
                
    return dist
5. Number of Operations to Make Network Connected (Disjoint Set Union)Problem: Given n computers and connections [u, v], return the minimum operations to connect all computers using existing extra cables. Return -1 if total cables are less than $n - 1$.Pythonclass DisjointSet:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n

    def find(self, i):
        if self.parent[i] != i:
            self.parent[i] = self.find(self.parent[i])  # Path compression
        return self.parent[i]

    def union(self, u, v):
        root_u = self.find(u)
        root_v = self.find(v)
        if root_u != root_v:
            if self.rank[root_u] < self.rank[root_v]:
                root_u, root_v = root_v, root_u
            self.parent[root_v] = root_u
            if self.rank[root_u] == self.rank[root_v]:
                self.rank[root_u] += 1
            return True
        return False

def makeConnected(n: int, connections: list[list[int]]) -> int:
    if len(connections) < n - 1:
        return -1
        
    ds = DisjointSet(n)
    components = n
    
    for u, v in connections:
        if ds.union(u, v):
            components -= 1
            
    return components - 1
