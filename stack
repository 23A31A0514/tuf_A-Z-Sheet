1. Check for Balanced ParenthesesProblem Statement: Given a string s containing just the characters '(', ')', '{', '}', '[' and ']', determine if the input string is valid. Open brackets must be closed by the same type of brackets and in the correct order.Python Code:Pythondef isValid(s: str) -> bool:
    stack = []
    mapping = {")": "(", "}": "{", "]": "["}
    for char in s:
        if char in mapping:
            top_element = stack.pop() if stack else '#'
            if mapping[char] != top_element:
                return False
        else:
            stack.append(char)
    return not stack
2. Next Greater Element IProblem Statement: Given an array nums, find the next greater element for each element. The next greater element of an element x is the first element to its right that is strictly greater than x. If it does not exist, return -1.Python Code:Pythondef nextGreaterElement(nums: list[int]) -> list[int]:
    stack = []
    nge = [-1] * len(nums)
    for i in range(len(nums) - 1, -1, -1):
        while stack and stack[-1] <= nums[i]:
            stack.pop()
        if stack:
            nge[i] = stack[-1]
        stack.append(nums[i])
    return nge
3. Implement Stack using QueuesProblem Statement: Implement a last-in-first-out (LIFO) stack using only a standard queue data structure (supporting push, pop, top, and empty).Python Code:Pythonfrom collections import deque

class MyStack:
    def __init__(self):
        self.q = deque()

    def push(self, x: int) -> None:
        self.q.append(x)
        for _ in range(len(self.q) - 1):
            self.q.append(self.q.popleft())

    def pop(self) -> int:
        return self.q.popleft()

    def top(self) -> int:
        return self.q[0]

    def empty(self) -> bool:
        return len(self.q) == 0
4. Min StackProblem Statement: Design a stack that supports push, pop, top, and retrieving the minimum element in constant time $O(1)$.Python Code:Pythonclass MinStack:
    def __init__(self):
        self.stack = []
        self.min_stack = []

    def push(self, val: int) -> None:
        self.stack.append(val)
        val = min(val, self.min_stack[-1] if self.min_stack else val)
        self.min_stack.append(val)

    def pop(self) -> None:
        self.stack.pop()
        self.min_stack.pop()

    def top(self) -> int:
        return self.stack[-1]

    def getMin(self) -> int:
        return self.min_stack[-1]
5. Infix to Postfix ConversionProblem Statement: Convert an algebraic expression given in Infix form (e.g., a+b*(c^d-e)) into Postfix form (e.g., abcd^e-*+) using operator precedence rules and a stack.Python Code:Pythondef infixToPostfix(exp: str) -> str:
    precedence = {'+': 1, '-': 1, '*': 2, '/': 2, '^': 3}
    output = []
    stack = []

    for char in exp:
        if char.isalnum():
            output.append(char)
        elif char == '(':
            stack.append(char)
        elif char == ')':
            while stack and stack[-1] != '(':
                output.append(stack.pop())
            stack.pop()
        else:
            while stack and stack[-1] != '(' and precedence.get(stack[-1], 0) >= precedence.get(char, 0):
                output.append(stack.pop())
            stack.append(char)

    while stack:
        output.append(stack.pop())

    return "".join(output)
