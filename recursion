    re(n-1)
re(n)

##sum of n numbers
n=int(input())
def re(n):
    if n<=0:
        return 0
    return n+re(n-1)
print(re(n))

## Fact of n
n=int(input())
def re(n):
    if n<=1:
        return 1
    return n*re(n-1)
print(re(n))

##Reverse of an array
arr=list(map(int,input().split()))
def re(i):
    if i>=len(arr):
        return
    re(i+1)
    print(arr[i],end=" ")
