n = int(input())

for i in range(n):
    for j in range(n):
        if i == 0 or i == n - 1 or j == 0 or j == n - 1:
            print("*", end="")
        else:
            print(" ", end="")
    print()
21. Hollow Pyramid
n = int(input())

for i in range(n):
    for j in range(2 * n - 1):
        if j == n - i - 1 or j == n + i - 1 or i == n - 1:
            print("*", end="")
        else:
            print(" ", end="")
    print()

