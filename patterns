22. Concentric Number Pattern

For n = 4

4444444
4333334
4322234
4321234
4322234
4333334
4444444
n = int(input())

size = 2 * n - 1

for i in range(size):
    for j in range(size):
        top = i
        left = j
        right = size - j - 1
        bottom = size - i - 1
        print(n - min(top, left, right, bottom), end="")
    print()
